# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection used by the backend app
DATABASE_URL="postgresql://habit:habit@localhost:5432/habit_tracker"

# Separate database used only by the backend test suite (never the dev DB)
DATABASE_URL_TEST="postgresql://habit:habit@localhost:5432/habit_tracker_test"

# Session/cookie signing secret (generate a long random string)
SESSION_SECRET="replace-with-a-long-random-string"

# Backend HTTP port
PORT=4000

# docker-compose dev Postgres credentials
POSTGRES_USER="habit"
POSTGRES_PASSWORD="habit"
POSTGRES_DB="habit_tracker"

# Seed script passwords (plaintext here only for local/dev seeding; never real secrets)
SEED_PASSWORD_MANAGER="replace-me"
SEED_PASSWORD_PARTICIPANT_1="replace-me"
SEED_PASSWORD_PARTICIPANT_2="replace-me"
